@@ -436,6 +436,48 @@ class OptimizationDataModel:
 
         return is_valid
 
+    def set_cost_matrix_csr(self, csr):
+        """B5: sparse (K-NN / CSR) cost-matrix ingestion.
+
+        The client sends only nearest-neighbour arcs (O(N*K)); we reconstruct the square cost
+        matrix server-side. Absent (i,j) pairs get a large finite sentinel (BIG_COST) so the
+        solver treats them as navigable-but-expensive (pair with vehicle_max_costs to forbid
+        them outright). This is the server-side reconstruction; a future never-materialize-dense
+        path lives in the C++ add_cost_matrix_csr API. Vectorized (O(nnz)), no Python row loop.
+        """
+        BIG_COST = 1.0e6
+
+        # csr may be a pydantic model (attrs) or a dict. Check dict FIRST -- a dict's
+        # built-in .values/.keys methods would shadow the data keys under getattr/hasattr.
+        def _get(obj, key):
+            if isinstance(obj, dict):
+                return obj[key]
+            return getattr(obj, key)
+
+        n = int(_get(csr, "n_locations"))
+        offsets = _get(csr, "offsets")
+        indices = _get(csr, "indices")
+        values = _get(csr, "values")
+
+        self.is_route_detail_set = True
+        self.cost_matrix = {}
+        for v_type in offsets.keys():
+            off = np.asarray(offsets[v_type], dtype=np.int64)
+            idx = np.asarray(indices[v_type], dtype=np.int64)
+            val = np.asarray(values[v_type], dtype=np.float32)
+            if off.shape[0] != n + 1:
+                return (False, "cost_matrix_csr.offsets must have length n_locations+1")
+            if idx.shape[0] != val.shape[0] or int(off[-1]) != idx.shape[0]:
+                return (False, "cost_matrix_csr indices/values length must equal offsets[-1]")
+            dense = np.full((n, n), BIG_COST, dtype=np.float32)
+            np.fill_diagonal(dense, 0.0)
+            counts = np.diff(off)
+            rows = np.repeat(np.arange(n, dtype=np.int64), counts)
+            dense[rows, idx] = val  # scatter the provided arcs
+            self.cost_matrix[int(v_type)] = cudf.DataFrame(dense)
+
+        return (True, "")
+
