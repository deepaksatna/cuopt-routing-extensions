+class CostMatrixCSR(StrictModel):
+    """B5: sparse (K-NN / CSR) cost matrix ingestion.
+
+    Lets the client send only each stop's nearest-neighbour arcs (O(N*K)) instead of the full
+    dense O(N^2) matrix, so a 10k-stop cost matrix travels as ~0.76 MB instead of ~2,290 MB
+    (past the 2 GB REST limit). Per vehicle-type CSR: row `offsets` [n+1], column `indices`
+    [nnz] (sorted within each row), and `values` [nnz]. Absent (i,j) pairs default to a large
+    finite sentinel server-side. n_locations is the square dimension.
+    """
+
+    n_locations: int = Field(
+        ..., description="Number of locations (square cost-matrix dimension)."
+    )
+    offsets: Dict[int, List[int]] = Field(
+        ..., description="vehicle-type -> CSR row offsets, length n_locations+1."
+    )
+    indices: Dict[int, List[int]] = Field(
+        ..., description="vehicle-type -> CSR column indices, length nnz, sorted within each row."
+    )
+    values: Dict[int, List[float]] = Field(
+        ..., description="vehicle-type -> CSR cost values, length nnz, cost >= 0."
+    )
+
+
