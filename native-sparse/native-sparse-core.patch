+  // Native sparse (Option D) prototype: build a CSR from the dense cost matrix.
+  // K <= 0 or K >= n keeps all entries (lossless); otherwise keep the K smallest-cost
+  // columns per row (K-NN). Columns are sorted so the device lookup can binary-search.
+  void build_csr(int K)
+  {
+    const int n = static_cast<int>(extent[3]);
+    if (n <= 0) { return; }
+    std::vector<f_t> dense(static_cast<size_t>(n) * static_cast<size_t>(n));
+    cudaMemcpyAsync(dense.data(), get_cost_matrix(0), sizeof(f_t) * dense.size(),
+                    cudaMemcpyDeviceToHost, stream.value());
+    stream.synchronize();
+    std::vector<int> h_off(static_cast<size_t>(n) + 1, 0);
+    std::vector<int> h_idx;
+    std::vector<f_t> h_val;
+    std::vector<int> cols(static_cast<size_t>(n));
+    std::vector<int> sel;
+    for (int i = 0; i < n; ++i) {
+      const size_t row = static_cast<size_t>(i) * static_cast<size_t>(n);
+      sel.clear();
+      if (i == 0 || K <= 0 || K >= n) {
+        // depot row (and lossless mode): keep every column so the depot reaches all nodes
+        for (int j = 0; j < n; ++j) { sel.push_back(j); }
+      } else {
+        for (int j = 0; j < n; ++j) { cols[static_cast<size_t>(j)] = j; }
+        std::nth_element(cols.begin(), cols.begin() + K, cols.end(),
+                         [&](int a, int b) {
+                           return dense[row + static_cast<size_t>(a)] <
+                                  dense[row + static_cast<size_t>(b)];
+                         });
+        sel.assign(cols.begin(), cols.begin() + K);
+        sel.push_back(0);  // depot connectivity: guarantees return-to-depot is feasible
+        sel.push_back(i);  // self
+        std::sort(sel.begin(), sel.end());
+        sel.erase(std::unique(sel.begin(), sel.end()), sel.end());
+      }
+      for (size_t t = 0; t < sel.size(); ++t) {
+        const int c = sel[t];
+        h_idx.push_back(c);
+        h_val.push_back(dense[row + static_cast<size_t>(c)]);
+      }
+      h_off[static_cast<size_t>(i) + 1] =
+        h_off[static_cast<size_t>(i)] + static_cast<int>(sel.size());
+    }
+    csr_offsets.resize(h_off.size(), stream);
+    csr_indices.resize(h_idx.size(), stream);
+    csr_values.resize(h_val.size(), stream);
+    cudaMemcpyAsync(csr_offsets.data(), h_off.data(), sizeof(int) * h_off.size(),
+                    cudaMemcpyHostToDevice, stream.value());
+    cudaMemcpyAsync(csr_indices.data(), h_idx.data(), sizeof(int) * h_idx.size(),
+                    cudaMemcpyHostToDevice, stream.value());
+    cudaMemcpyAsync(csr_values.data(), h_val.data(), sizeof(f_t) * h_val.size(),
+                    cudaMemcpyHostToDevice, stream.value());
+    stream.synchronize();
+    sparse_built = true;
+  }
+
   size_t extent[NCON_DIMS];
   rmm::device_uvector<f_t> buffer;
   rmm::cuda_stream_view stream;
+  rmm::device_uvector<int> csr_offsets;
+  rmm::device_uvector<int> csr_indices;
+  rmm::device_uvector<f_t> csr_values;
+  bool sparse_built{false};
 };
 
